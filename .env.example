# نمونه‌ی فایل محیطی. کپی کنید به `.env` و مقادیر را پر کنید.
# `.env` هرگز کامیت نمی‌شود؛ همین فایل نمونه کامیت می‌شود.

# --- تنظیمات سراسری رصام (پیشوند RASAM_) ---
# کلید و آدرس سرویس مدل. با عوض‌کردن فقط BASE_URL می‌شود به مدل محلی
# (Ollama / vLLM) رفت — برای مشتری‌ای که داده‌اش نباید از سرورش خارج شود.
RASAM_LLM_API_KEY=
RASAM_LLM_BASE_URL=https://openrouter.ai/api/v1
RASAM_LLM_MODEL=

# سقف توکن خروجی اجباری است: بدون آن سرویس ممکن است خطای ۴۰۲ بدهد.
RASAM_LLM_MAX_TOKENS=1024
# برای تولید کوئری، خروجی قطعی از خلاقیت مهم‌تر است.
RASAM_LLM_TEMPERATURE=0.1
# مدل‌های هیبریدی (مثل Qwen3) پیش‌فرض توکن «فکر کردن» تولید می‌کنند:
# کند، گران و برای تولید کوئری بی‌فایده.
RASAM_LLM_DISABLE_REASONING=true

# چاپ پرامپت کامل و پاسخ خام مدل. مهم‌ترین ابزار عیب‌یابی پروژه.
RASAM_VERBOSE=0

# محل پوشه‌ی مشتری‌ها؛ نسبی یعنی نسبت به ریشه‌ی پروژه.
RASAM_CUSTOMERS_DIR=customers

# --- اتصال دیتابیس مشتری‌ها ---
# نامِ هر متغیر در `profile.yaml` همان مشتری اعلام می‌شود (کلید `uri_env`).
# خودِ رشته‌ی اتصال فقط اینجاست، هرگز داخل پروفایل.
# کاربر باید فقط-خواندنی باشد (قاعده‌ی غیرقابل مذاکره‌ی شماره‌ی ۲).
DEMO_MONGO_URI=mongodb://rasam_ro:CHANGE_ME@localhost:27017/solar_telemetry
